@using EvidenceRezervaceMistnosti.DTO.PartialView;
@model List<ReservationRowDTO>


@foreach(ReservationRowDTO detail in Model)
{
    <div class="detail-card">
        <div class="row align-items-center">
            <div class="col-lg-5">
                <h5 class="reservation-title">Místnost: @detail.RoomName</h5>
                <p class="reservation-location mb-0">
                    Počet lidí @detail.NumberOfPeople
                </p>
            </div>

            <div class="col-sm-6 col-lg-3 mt-3 mt-lg-0">
                <span class="detail-label">Čas rezervace</span>
                <strong class="d-block">@detail.DayReservation</strong>
                <strong class="d-block">@detail.TimeReservation</strong>
            </div>

            <div class="col-sm-6 col-lg-2 mt-3 mt-lg-0">
                <span class="badge bg-success-subtle text-success">
                    @detail.UserName
                </span>
            </div>

            <div class="col-lg-2 mt-3 mt-lg-0 text-lg-end">
                <a class="btn btn-sm btn-outline-success" href="detail/reservation/@(detail.ReservationId)">
                    Detail
                </a>
            </div>
        </div>
    </div>
}
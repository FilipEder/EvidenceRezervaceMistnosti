@using EvidenceRezervaceMistnosti.DTO.PartialView;
@using Microsoft.Extensions.Localization;

@model ReservationDashboardDTO

@inject IStringLocalizer<Trans> Localizer;

<div class="detail-container">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3">
        <div>
            <h4 class="mb-1">@Localizer["Reservations"]</h4>
        </div>
        <a class="btn btn-success mt-3 mt-sm-0" type="button"
                asp-action="CreateReservation" asp-controller="Create">
            + @Localizer["New reservation"]
        </a>
    </div>
    <div class="detail-overflow">
        @await Html.PartialAsync("~/Views/Shared/Detail/ReservationRow.cshtml", Model.ReservationRows)
    </div>
</div>
<!-- Počet lidí -->
<div class="filter-section" id="CapacityFilter">
    <div class="filter-header">
        Počet lidí
    </div>
    <div class="row g-2">
        <div class="col-12">
            <input id="NumberOfPeopleInput"
                   name="NumberOfPeople"
                   class="form-control"
                   type="number"
                   min="1"
                   placeholder="1">
        </div>
    </div>
</div>

<!-- Datum a čas -->
<div class="filter-section" id="DateFilter">
    <div class="filter-header">
        Datum a čas
    </div>

    <div class="mb-2">
        <label class="form-label" for="ReservationDateInput">Den</label>
        <input id="ReservationDateInput"
               class="form-control"
               type="date">
    </div>

    <div class="row g-2">
        <div class="col-6">
            <label class="form-label" for="TimeFromInput">Od</label>
            <input id="TimeFromInput"
                   class="form-control"
                   type="time">
        </div>

        <div class="col-6">
            <label class="form-label" for="TimeToInput">Do</label>
            <input id="TimeToInput"
                   class="form-control"
                   type="time">
        </div>
    </div>
</div>
@using EvidenceRezervaceMistnosti.Models.ViewModel;
@using Microsoft.Extensions.Localization;

@inject IStringLocalizer<Trans> Localizer;

@{
    ViewData["Title"] = "Dashboard rezervací";
}

@model ReservationDashboardViewModel

@section Style {
    <link href="~/lib/choices.js/choices.min.css" rel="stylesheet" />
}

<link rel="stylesheet" href="~/css/homepage.css" />
<div class="page-container py-4">

    <h2 class="header mb-4 text-center">
        @Localizer["Meeting Room Reservation Records"]
    </h2>
    <div class="container reservation-container bg-white rounded shadow-sm" style="padding: 0 !important">
        <div class="row g-0 h-100">
            <!-- Levý panel s filtry -->
            <aside class="d-flex flex-column justify-content-between col-12 col-md-4 col-lg-3 filter-sidebar">
                <form asp-controller="Dashboard"
                      asp-action="ReservationDashboard"
                      method="get">
                    <div class="fillter-upper-side">
                        <div class="sidebar-header">
                            <h5>@Localizer["Filter Reservations"]</h5>
                        </div>
                        <!-- Vyhledávání -->
                        <div class="search-container mb-3">
                            <label class="form-label" for="searchInput">
                                @Localizer["Search"]
                            </label>
                            <input id="searchInput"
                                   class="form-control"
                                   name="search"
                                   value="@(Model.Search ?? "")"
                                   placeholder="@Localizer["Search by person or room..."]"
                                   type="search">
                        </div>
                        <!-- Místnost -->
                        <div class="filter-section" id="RoomFilter">
                            <label class="filter-header" for="RoomSelect">
                                @Localizer["Room"]
                            </label>
                            <select id="RoomSelect"
                                    class="form-select"
                                    name="roomId"
                                    data-choices-search="@Localizer["Search rooms..."]"
                                    data-choices-no-results="@Localizer["No matching results"]"
                                    data-choices-no-options="@Localizer["No more rooms to choose"]"
                                    data-choices-select-text="@Localizer["Click to select"]"
                                    disabled="@(Model.Rooms.Any() ? null : "disabled")">
                                @if (!Model.Rooms.Any())
                                {
                                    <option value="" selected disabled>@Localizer["No rooms available"]</option>
                                }
                                else
                                {
                                    <option value="" selected="@(Model.RoomId == null ? "selected" : null)">
                                        @Localizer["All Rooms"]
                                    </option>
                                    foreach (var room in Model.Rooms)
                                    {
                                        <option value="@room.RoomId" selected="@(room.RoomId == Model.RoomId ? "selected" : null)">
                                            @room.RoomName
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <!-- Počet lidí -->
                        <div class="filter-section" id="CapacityFilter">
                            <div class="filter-header">
                                @Localizer["Number of People"]
                            </div>
                            <div class="row g-2">
                                <div class="col-12">
                                    <input id="NumberOfPeopleInput"
                                           name="numberOfPeople"
                                           class="form-control"
                                           type="number"
                                           value="@Model.NumberOfPeople"
                                           min="1"
                                           placeholder="1">
                                </div>
                            </div>
                        </div>

                        <!-- Datum a čas -->
                        <div class="filter-section" id="DateFilter">
                            <div class="filter-header">
                                @Localizer["Date and Time"]
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="ReservationDateInput">@Localizer["Day"]</label>
                                <input id="ReservationDateInput"
                                       class="form-control"
                                       value="@(Model.Day != null ? Model.Day.Value.ToString("yyyy-MM-dd") : "")"
                                       name="day"
                                       type="date">
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label" for="TimeFromInput">@Localizer["From"]</label>
                                    <input id="TimeFromInput"
                                           class="form-control"
                                           name="timeFrom"
                                           value="@(Model.TimeFrom != null ? Model.TimeFrom.Value.ToString("HH:mm") : "")"
                                           type="time">
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="TimeToInput">@Localizer["To"]</label>
                                    <input id="TimeToInput"
                                           class="form-control"
                                           value="@(Model.TimeTo != null ? Model.TimeTo.Value.ToString("HH:mm") : "")"
                                           name="timeTo"
                                           type="time">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="filter-bottom-side">
                        <!-- Tlačítka -->
                        <div class="d-grid gap-2 mt-3 filter-buttons">
                            <button id="filterButton" class="btn btn-success" type="submit">
                                @Localizer["Apply Filters"]
                            </button>
                            <a asp-controller="Dashboard"
                               asp-action="ReservationDashboard"
                               id="clearFilterButton"
                               class="btn btn-outline-secondary">
                                @Localizer["Clear Filters"]
                            </a>
                        </div>
                    </div>
                </form>
            </aside>
            <!-- Pravá část -->
            <main class="col-12 col-md-8 col-lg-9 main-content">
                <!-- Přepínání záložek -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <a
                           class="detail-tab active">
                            @Localizer["Reservations"]
                        </a>
                    </div>

                    <div class="col-6">
                        <a asp-controller="Dashboard"
                           asp-action="RoomDashboard"
                           class="detail-tab">
                            @Localizer["Rooms"]
                        </a>
                    </div>
                </div>
                <!-- Obsah -->
                @await Html.PartialAsync("~/Views/Shared/Detail/ReservationDashboard.cshtml", Model.ReservationDashboard)
            </main>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/choices.js/choices.min.js"></script>
}

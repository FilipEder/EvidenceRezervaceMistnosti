@using Microsoft.Extensions.Localization;
@using EvidenceRezervaceMistnosti.Models.ViewModel;

@inject IStringLocalizer<Trans> Localizer;

@{
    ViewData["Title"] = "Dashboard místností";
}

@model RoomDashboardViewModel

@section Style {
    <link href="~/lib/choices.js/choices.min.css" rel="stylesheet" />
}

<link rel="stylesheet" href="~/css/homepage.css" />
<div class="page-container py-4">

    <h2 class="header mb-4 text-center">
        @Localizer["Meeting Room Reservation Records"]
    </h2>
    <div class="container reservation-container bg-white rounded shadow-sm" style="padding: 0 !important">
        <div class="row g-0 h-100">
            <!-- Levý panel s filtry -->
            <aside class="d-flex flex-column justify-content-between col-12 col-md-4 col-lg-3 filter-sidebar">
                <form asp-controller="Dashboard"
                      asp-action="RoomDashboard"
                      method="get">
                    <div class="fillter-upper-side">
                        <div class="sidebar-header">
                            <h5>@Localizer["Filter by Room"]</h5>
                        </div>
                        <!--Filtry-->
                        <!-- Vyhledávání -->
                        <div class="search-container mb-3">
                            <label class="form-label" for="searchInput">
                                @Localizer["Search"]
                            </label>
                            <input id="searchInput"
                                   class="form-control"
                                   name="search"
                                   value="@(Model.Search ?? "")"
                                   placeholder="@Localizer["Search for a room, equipment, or floor..."]"
                                   type="search">
                        </div>
                        <!-- Kapacita -->
                        <div class="filter-section" id="CapacityFilter">
                            <div class="filter-header">
                                @Localizer["Capacity"]
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label" for="CapacityFromInput">Od</label>
                                    <input id="CapacityFromInput"
                                           class="form-control"
                                           type="number"
                                           name="CapacityFrom"
                                           value="@(Model.CapacityFrom?.ToString() ?? "")"
                                           min="1"
                                           placeholder="1">
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="CapacityToInput">Do</label>
                                    <input id="CapacityToInput"
                                           class="form-control"
                                           type="number"
                                           name="CapacityTo"
                                           value="@(Model.CapacityTo?.ToString() ?? "")"
                                           min="1"
                                           placeholder="20">
                                </div>
                            </div>
                        </div>
                        <!-- Umístění -->
                        <div class="filter-section" id="LocationFilter">
                            <div class="filter-header">
                                @Localizer["Location"]
                            </div>

                            <label class="form-label" for="LocationSelect">@Localizer["Floor"]</label>
                            <select id="LocationSelect"
                                    class="form-select"
                                    name="LocationId"
                                    data-choices-search="@Localizer["Search locations..."]"
                                    data-choices-no-results="@Localizer["No matching results"]"
                                    data-choices-no-options="@Localizer["No more locations to choose"]"
                                    data-choices-select-text="@Localizer["Click to select"]">
                                @if (Model.Locations == null || !Model.Locations.Any())
                                {
                                    <option value="" disabled>@Localizer["No locations available"]</option>
                                }
                                else
                                {
                                    <option value="" selected>@Localizer["All Locations"]</option>
                                    foreach (var floor in Model.Locations)
                                    {
                                        if (floor.LocationId == Model.LocationId)
                                        {
                                            <option value="@floor.LocationId" selected>
                                                @Localizer[floor.LocationName]
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@floor.LocationId">
                                                @Localizer[floor.LocationName]
                                            </option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <!-- Vybavení -->
                        <div class="filter-section" id="EquipmentFilter">
                            <div class="filter-header">
                                @Localizer["Equipment"]
                            </div>
                            <label class="form-label" for="EquipmentSelect">
                                @Localizer["Equipment Type"]
                            </label>
                            <select id="EquipmentSelect"
                                    class="form-select"
                                    name="EquipmentId"
                                    data-choices-search="@Localizer["Search equipment..."]"
                                    data-choices-no-results="@Localizer["No matching results"]"
                                    data-choices-no-options="@Localizer["No more equipment to choose"]"
                                    data-choices-select-text="@Localizer["Click to select"]">
                                @if (Model.Equipments == null || !Model.Equipments.Any())
                                {
                                    <option value="" disabled>@Localizer["No equipment available"]</option>
                                }
                                else
                                {
                                    <option value="" selected="@(Model.EquipmentId == null ? "selected" : null)">@Localizer["All Equipment"]</option>
                                    foreach (var equipment in Model.Equipments)
                                    {
                                        if (equipment.EquipmentId == Model.EquipmentId)
                                        {
                                            <option value="@equipment.EquipmentId" selected>
                                                @Localizer[equipment.EquipmentName]
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@equipment.EquipmentId">
                                                @Localizer[equipment.EquipmentName]
                                            </option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="filter-bottom-side">
                        <!-- Tlačítka -->
                        <div class="d-grid gap-2 mt-3 filter-buttons">
                            <button id="filterButton" class="btn btn-success" type="submit">
                                @Localizer["Apply Filters"]
                            </button>
                            <button id="clearFilterButton" class="btn btn-outline-secondary" type="button">
                                @Localizer["Clear Filters"]
                            </button>
                        </div>
                    </div>
                </form>
            </aside>

            <!-- Pravá část -->
            <main class="col-12 col-md-8 col-lg-9 main-content">
                <!-- Přepínání záložek -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <a asp-controller="Dashboard"
                           asp-action="ReservationDashboard"
                           class="detail-tab">
                            @Localizer["Reservations"]
                        </a>
                    </div>
                    <div class="col-6">
                        <a 
                           class="detail-tab active">
                            @Localizer["Rooms"]
                        </a>
                    </div>
                </div>
                <!-- Obsah -->
                @await Html.PartialAsync("~/Views/Shared/Detail/RoomDashboard.cshtml", Model.RoomDashboard)
            </main>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/choices.js/choices.min.js"></script>
}

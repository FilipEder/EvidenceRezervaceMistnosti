@using Microsoft.Extensions.Localization;
@using EvidenceRezervaceMistnosti.DTO.Form;
@inject IStringLocalizer<Trans> Localizer;

@model RoomFormDTO

@{
    ViewData["Title"] = Localizer["Create Room"];
}

@section Style {
    <link rel="stylesheet" href="~/css/form.css" />
    <link href="~/lib/choices.js/choices.min.css" rel="stylesheet" />
    <link href="~/lib/toastify-js/toastify.min.css" rel="stylesheet" />
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<div class="page-container form-page py-4">
    <div class="container form-page-width">
        <div class="form-page-toolbar">
            <a asp-controller="Dashboard"
               asp-action="RoomDashboard"
               class="btn btn-sm btn-outline-secondary form-back-button">
                <span aria-hidden="true">←</span>
                @Localizer["Back"]
            </a>
        </div>

        <article class="form-workspace" data-form-workspace>
            <header class="form-intro">
                <div>
                    <h1 class="form-title">@Localizer["Create Room"]</h1>
                </div>
                <span class="form-status">
                    @Localizer["New Room"]
                </span>
            </header>

            <form id="room-form"
                  class="app-form"
                  asp-controller="RoomApi"
                  asp-action="Post"
                  method="post"
                  novalidate
                  data-mode="create"
                  data-saving-label="@Localizer["Saving..."]"
                  data-search-equipment="@Localizer["Search equipment..."]"
                  data-select-equipment="@Localizer["Select equipment..."]"
                  data-no-equipment="@Localizer["No more equipment to choose"]"
                  data-search-locations="@Localizer["Search locations..."]"
                  data-select-location="@Localizer["Select a location..."]"
                  data-no-locations="@Localizer["No more locations to choose"]"
                  data-click-to-select="@Localizer["Click to select"]"
                  data-success-title="@Localizer["Great job!"]"
                  data-success-message="@Localizer["Room was created successfully!"]"
                  data-name-required="@Localizer["Enter a room name"]"
                  data-name-length="@Localizer["Room name must contain 5 to 120 characters"]"
                  data-capacity-range="@Localizer["Capacity must be between 1 and 1000"]"
                  data-location-required="@Localizer["Select a location"]"
                  data-validation-summary="@Localizer["Please correct the highlighted fields"]"
                  data-server-error="@Localizer["Server error while saving"]"
                  data-connection-error="@Localizer["Could not connect to the server"]">

                <section class="form-section" aria-labelledby="room-basic-heading">
                    <div class="form-section-heading">
                        <div>
                            <h2 id="room-basic-heading">@Localizer["Basic information"]</h2>
                            <p>@Localizer["Room name must contain 5 to 120 characters"]</p>
                        </div>
                    </div>

                    <div class="form-grid form-grid--room-basics">
                        <div class="form-group">
                            <label for="name" class="form-label">
                                @Localizer["Room Name"]
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <input type="text"
                                   id="name"
                                   name="Name"
                                   minlength="5"
                                   maxlength="120"
                                   class="form-control form-control-lg"
                                   autocomplete="off"
                                   aria-describedby="room-name-help"
                                   required />
                            <div id="room-name-help" class="form-text">@Localizer["Room name must contain 5 to 120 characters"]</div>
                        </div>

                        <div class="form-group">
                            <label for="capacity-input" class="form-label">
                                @Localizer["Capacity"]
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <input type="number"
                                   id="capacity-input"
                                   name="Capacity"
                                   min="1"
                                   max="1000"
                                   step="1"
                                   class="form-control form-control-lg"
                                   inputmode="numeric"
                                   aria-describedby="room-capacity-help"
                                   required />
                            <div id="room-capacity-help" class="form-text">@Localizer["Capacity must be between 1 and 1000"]</div>
                        </div>
                    </div>
                </section>

                <section class="form-section" aria-labelledby="room-setup-heading">
                    <div class="form-section-heading">
                        <div>
                            <h2 id="room-setup-heading">@Localizer["Location and equipment"]</h2>
                            <p>@Localizer["Select a location"]</p>
                        </div>
                    </div>

                    <div class="form-grid form-grid--stacked">
                        <div class="form-group">
                            <label for="location-select" class="form-label">
                                @Localizer["Location"]
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <select name="LocationId" id="location-select" class="form-select form-select-lg" required>
                                <option value="" disabled selected>@Localizer["Select a location"]</option>
                                @if (Model.LocationSelect == null || !Model.LocationSelect.Any())
                                {
                                    <option value="" disabled>@Localizer["No locations available"]</option>
                                }
                                else
                                {
                                    foreach (var floor in Model.LocationSelect)
                                    {
                                        <option value="@floor.LocationId">@Localizer[floor.LocationName]</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <div class="form-field-label d-flex justify-content-between align-items-center gap-2">
                                <label for="gear-select" class="form-label mb-0">@Localizer["Equipment"]</label>
                                <span class="optional-label">@Localizer["Optional"]</span>
                            </div>
                            <select name="GearIds" class="form-select" id="gear-select" multiple>
                                @if (Model.EquipmentSelect == null || !Model.EquipmentSelect.Any())
                                {
                                    <option value="" disabled>@Localizer["No equipment available"]</option>
                                }
                                else
                                {
                                    foreach (var equipment in Model.EquipmentSelect)
                                    {
                                        <option value="@equipment.EquipmentId">@Localizer[equipment.EquipmentName]</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </section>

                <footer class="form-actions mb-4">
                    <a asp-controller="Dashboard"
                       asp-action="RoomDashboard"
                       class="btn btn-outline-secondary">
                        @Localizer["Cancel"]
                    </a>
                    <button type="submit" class="btn btn-success button-submit">
                        @Localizer["Create Room"]
                    </button>
                </footer>
            </form>
        </article>
    </div>
</div>

@section Scripts {
    <script src="~/lib/choices.js/choices.min.js"></script>
    <script src="~/lib/toastify-js/toastify.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/form/RoomForm.js" asp-append-version="true"></script>
}
